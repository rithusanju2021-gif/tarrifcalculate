# ============================================================
# Rithish Tours & Travels — RTTTarrif Project .gitignore
# ============================================================

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/

# Build logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
backend/.env

# ─── Python / Django ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/
env/

# Django runtime
backend/db.sqlite3
backend/staticfiles/
backend/media/
backend/*.sqlite3

# Python eggs & packaging
*.egg-info/
dist/
build/
.eggs/
*.egg

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy / type checkers
.mypy_cache/
.dmypy.json

# ─── macOS ──────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Windows ────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── IDE / Editors ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ─── Temporary & OS ─────────────────────────────────────────
*.local
*.tmp
*.temp
*.bak
*.orig
