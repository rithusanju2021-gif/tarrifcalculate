# ============================================================
# Rithish Tours & Travels — Backend Environment Variables
# Copy this to backend/.env for local development
# NEVER commit the actual .env file to Git
# ============================================================

# ─── Django Core ────────────────────────────────────────────
# Generate a new secret for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-long-random-secret-key-before-deploying

# Set to False in production — NEVER True on Render/production
DEBUG=True

# Comma-separated allowed hosts
# Local dev: localhost,127.0.0.1
# Production: your-app-name.onrender.com,planner.rithishtoursandtravels.in
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database — Aiven MySQL 8 ───────────────────────────────
# Option A: Full DATABASE_URL from Aiven Service URI:
# DATABASE_URL=mysql://avnadmin:your_password@your-mysql.aivencloud.com:28761/defaultdb?ssl-mode=REQUIRED
#
# Option B: Individual connection parameters:
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=28761
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-mysql-password-here
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
#
# Leave both empty to use local SQLite development (default)

# ─── CORS & CSRF (Production) ───────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://planner.rithishtoursandtravels.in,https://rtttarrif.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Security (Production) ──────────────────────────────────
# Set these in Render environment — leave empty for local dev
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=True
